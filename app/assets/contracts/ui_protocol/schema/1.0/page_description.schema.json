{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramtree.app/contracts/ui_protocol/1.0/page_description.schema.json",
  "title": "GramTree 页面描述协议 1.0",
  "description": "服务端组合模块下发、App 渲染前都要校验的页面描述信封。这份文件是协议的唯一来源（server 和 app 都从这里读，不各写一份）。每个组件的 `data` 字段在这里只校验成一个对象；具体到某个组件类型的数据格式，由 contracts/ui_protocol/schema/1.0/components/<type>.schema.json 分别定义，渲染方（App）按 `type` 查到对应组件登记项后再校验一次 `data`（SPEC-009.1 #77）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "page_type",
    "composition_id",
    "generated_at",
    "cache",
    "components"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "description": "协议版本，大版本.小版本。同一大版本下小版本只做向后兼容的增加；App 不认识的大版本要整页改用标准布局。",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "page_type": {
      "type": "string",
      "description": "页面类型，例如 today。App 请求时已经声明了要哪个页面类型。",
      "minLength": 1
    },
    "composition_id": {
      "type": "string",
      "description": "这次组合的随机 UUID，写进经验层事件、跳转下一页时带上。",
      "format": "uuid"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "服务端生成这份描述的时间。"
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depends_on", "ttl_s"],
      "properties": {
        "depends_on": {
          "type": "object",
          "description": "这次组合依赖的内容版本，key 是依赖名、value 是版本标识。App 离线时只有本机记录的依赖版本和这里完全一致才使用本机缓存。",
          "additionalProperties": { "type": "string" }
        },
        "ttl_s": {
          "type": "integer",
          "minimum": 0,
          "description": "缓存有效期（秒）。"
        }
      }
    },
    "experiment": {
      "description": "实验标识，没有参与实验时为 null。",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["experiment", "variant"],
          "properties": {
            "experiment": { "type": "string", "minLength": 1 },
            "variant": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "fallback": {
      "description": "非 null 表示这份描述其实是标准布局兜底（SPEC-009.1 #79），components 为空数组，reason 说明兜底原因。默认组合（没有兜底）时这个字段不出现。",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code"],
          "properties": {
            "reason_code": {
              "type": "string",
              "enum": [
                "unknown_major",
                "unknown_component",
                "illegal_action",
                "invalid_data",
                "missing_required",
                "server_error",
                "timeout"
              ]
            }
          }
        }
      ]
    },
    "components": {
      "type": "array",
      "description": "按顺序渲染的组件列表。底部五入口、主要按钮位置、做菜模式操作方式、记录卡入口不出现在这里，固定写在 App 里。",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "detail", "data", "actions", "reason", "required"],
      "properties": {
        "type": {
          "type": "string",
          "description": "组件类型名，必须是 App 已登记的组件；服务端只下发 App 声明支持的组件类型。",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "description": "这份描述里的组件实例 ID，用于事件记录里的“组件实例”。",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "enum": ["brief", "standard", "detailed"],
          "description": "详略级别：简略只显示结论和一个主要动作，标准加依据入口，详细把依据摊开。"
        },
        "data": {
          "type": "object",
          "description": "组件数据，具体形状由 components/<type>.schema.json 定义（按 type 分别校验）。"
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "reason": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "text"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          },
          "description": "为什么显示这个组件、这个详略级别。"
        },
        "required": {
          "type": "boolean",
          "description": "是否是必显组件（食品安全、过敏提示、来源署名、隐私控制等）。页面类型声明的必显组件缺失时整份描述校验失败。"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "params"],
      "properties": {
        "intent": {
          "type": "string",
          "description": "必须是 App 已登记的意图名（SPEC-009.1 #81），例如 open_page、start_cooking。",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "description": "意图参数，格式由该意图自己校验。"
        }
      }
    }
  }
}
