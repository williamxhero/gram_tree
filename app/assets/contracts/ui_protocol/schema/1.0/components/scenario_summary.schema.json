{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramtree.app/contracts/ui_protocol/1.0/components/scenario_summary.schema.json",
  "title": "场景详略摘要",
  "type": "object",
  "additionalProperties": false,
  "required": ["conclusion", "steps_collapsed", "layout", "source"],
  "properties": {
    "conclusion": {"type": "string", "minLength": 1},
    "steps_collapsed": {"type": "boolean"},
    "layout": {"enum": ["phone", "tablet"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "value", "basis"],
      "properties": {
        "source_type": {"const": "scenario_adjusted"},
        "value": {"type": "string", "minLength": 1},
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code", "text", "citation"],
          "properties": {
            "reason_code": {"type": "string", "minLength": 1},
            "text": {"type": "string", "minLength": 1},
            "citation": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
