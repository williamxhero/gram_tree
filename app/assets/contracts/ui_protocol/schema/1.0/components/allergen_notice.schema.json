{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramtree.app/contracts/ui_protocol/1.0/components/allergen_notice.schema.json",
  "title": "allergen_notice 组件数据",
  "description": "必显过敏原提示。无结果时 status 为 unknown/error，conclusion 清楚说明无法确认，不能表示为安全。",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "conclusion", "basis", "result"],
  "properties": {
    "status": { "type": "string", "enum": ["available", "unknown", "error"] },
    "conclusion": { "type": "string", "minLength": 1 },
    "basis": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "personal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "alerts", "unknown_ingredients", "incomplete"],
      "properties": {
        "status": { "type": "string", "enum": ["available", "not_authorized"] },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["person", "kind", "target", "ingredient", "replacement"],
            "properties": {
              "person": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["allergy", "avoidance"] },
              "target": { "type": "string", "minLength": 1 },
              "ingredient": { "type": "string", "minLength": 1 },
              "replacement": { "type": "boolean" }
            }
          }
        },
        "unknown_ingredients": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "incomplete": { "type": "boolean" }
      }
    },
    "result": {
      "description": "供页面使用的过敏原检查结果子集；null 时必须依据 status/conclusion 显示不可确认说明。",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules_version", "checked_at", "allergens", "allergens_incomplete", "replacement_allergens"],
          "properties": {
            "rules_version": { "type": "string", "minLength": 1 },
            "checked_at": { "type": "string", "format": "date-time" },
            "allergens": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "allergens_incomplete": { "type": "boolean" },
            "replacement_allergens": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ingredient_id", "display_name", "allergens", "incomplete"],
                "properties": {
                  "ingredient_id": { "type": "string", "minLength": 1 },
                  "display_name": { "type": "string", "minLength": 1 },
                  "allergens": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "incomplete": { "type": "boolean" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
