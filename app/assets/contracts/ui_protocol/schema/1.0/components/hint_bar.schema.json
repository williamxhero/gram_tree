{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramtree.app/contracts/ui_protocol/1.0/components/hint_bar.schema.json",
  "title": "hint_bar 组件数据",
  "description": "提示条：一句话结论，依据、明细层可选（SPEC-009.1 #80：标准档显示依据占位，详细档摊开依据、显示明细入口）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["conclusion"],
  "properties": {
    "conclusion": {
      "type": "string",
      "minLength": 1,
      "description": "结论层：一眼可读的一句话。"
    },
    "basis": {
      "description": "依据层：可选，一句说明文字。",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "action_label": {
      "type": "string",
      "minLength": 1,
      "description": "主要动作（整条可点）的读屏文案，没有主要动作时不出现。"
    },
    "detail_label": {
      "type": "string",
      "minLength": 1,
      "description": "明细入口的文案，只在详细档显示，没有第二个动作时不出现。"
    }
  }
}
