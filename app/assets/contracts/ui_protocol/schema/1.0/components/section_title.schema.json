{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramtree.app/contracts/ui_protocol/1.0/components/section_title.schema.json",
  "title": "section_title 组件数据",
  "description": "分区标题：结论层是标题文字，meta 是标准档起显示的附加说明（比如计数），依据、明细层可选（SPEC-009.1 #80）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["conclusion"],
  "properties": {
    "conclusion": {
      "type": "string",
      "minLength": 1,
      "description": "结论层：分区标题文字。"
    },
    "meta": {
      "type": "string",
      "minLength": 1,
      "description": "标准档起显示的附加说明，比如“3 道”。"
    },
    "basis": {
      "description": "依据层：可选，一句说明文字。",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "action_label": {
      "type": "string",
      "minLength": 1,
      "description": "主要动作按钮的文案，没有主要动作时不出现。"
    },
    "detail_label": {
      "type": "string",
      "minLength": 1,
      "description": "明细入口的文案，只在详细档显示，没有第二个动作时不出现。"
    }
  }
}
