# 复制成 .env 后按环境填写。开发机直接用 docker compose 默认值即可。
GRAMTREE_ENV=dev
GRAMTREE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gramtree
GRAMTREE_REDIS_URL=redis://localhost:6379/0
GRAMTREE_LOG_LEVEL=INFO
# 告警邮件（告警方式和地址用 gramtree config set ops.alert_channel / ops.alert_target 设置）
GRAMTREE_SMTP_HOST=
GRAMTREE_SMTP_PORT=25
GRAMTREE_SMTP_FROM=alerts@gramtree.local
# 备份
GRAMTREE_BACKUP_DIR=/var/backups/gramtree
GRAMTREE_BACKUP_REMOTE=
