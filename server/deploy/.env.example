GRAMTREE_ENV=prod
GRAMTREE_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=请换成随机长密码
GRAMTREE_LOG_LEVEL=INFO
# 备份的异地位置：rclone 的 remote:path，remote 在 rclone.conf 里配置
GRAMTREE_BACKUP_REMOTE=offsite:gramtree-backups
GRAMTREE_SMTP_HOST=
GRAMTREE_SMTP_PORT=25
GRAMTREE_SMTP_FROM=alerts@example.com
