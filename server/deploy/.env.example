GRAMTREE_ENV=prod
GRAMTREE_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=请换成随机长密码
GRAMTREE_LOG_LEVEL=INFO
# 备份的异地位置：rclone 的 remote:path，remote 在 rclone.conf 里配置
GRAMTREE_BACKUP_REMOTE=offsite:gramtree-backups
GRAMTREE_SMTP_HOST=
GRAMTREE_SMTP_PORT=25
GRAMTREE_SMTP_FROM=alerts@example.com
GRAMTREE_SMTP_USERNAME=
GRAMTREE_SMTP_PASSWORD=
GRAMTREE_SMTP_STARTTLS=true
# 账号与登录（SPEC-013.2）
# 访问令牌签名密钥，至少 32 位随机串，例如 openssl rand -hex 32 生成；换掉会让所有人重新登录
GRAMTREE_AUTH_SECRET=
# 私密过敏数据：独立随机 32 字节 AES-GCM 密钥，URL-safe base64 编码。不得复用令牌密钥
# 生成方式见 README；不要把实际密钥写进镜像/仓库/日志。缺失或错误仅禁用敏感读写
GRAMTREE_SENSITIVE_DATA_KEY=
# 验证码邮件走 SMTP（正式环境必须是 smtp）
GRAMTREE_MAIL_BACKEND=smtp
GRAMTREE_MAIL_FROM=味谱 <no-reply@example.com>
# 通过 Apple 登录：App 的 Bundle ID；Team ID、Key ID 和 .p8 私钥内容（用来注销时撤销授权）
# GRAMTREE_APPLE_CLIENT_ID 留空则不启用 Apple 登录
GRAMTREE_APPLE_CLIENT_ID=
GRAMTREE_APPLE_TEAM_ID=
GRAMTREE_APPLE_KEY_ID=
GRAMTREE_APPLE_PRIVATE_KEY=
